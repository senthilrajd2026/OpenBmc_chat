# =========================================================
# openbmc-ft-poc environment configuration
# Copy this file to .env and fill in your values
# =========================================================

# GitHub Personal Access Token (needed for issue fetching)
# Create one at: https://github.com/settings/tokens
# Required scopes: public_repo (read-only is fine)
GITHUB_TOKEN=ghp_your_token_here

# LLM provider for dataset generation
# Options: mock, openai, anthropic, local
LLM_PROVIDER=mock

# OpenAI (if using openai provider)
OPENAI_API_KEY=sk-your_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (if using anthropic provider)
ANTHROPIC_API_KEY=sk-ant-your_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Local LLM endpoint (if using local provider)
LOCAL_LLM_URL=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=mistral:7b

# Data directories (override defaults if needed)
# DATA_RAW_DIR=data/raw
# DATA_INTERMEDIATE_DIR=data/intermediate
# DATA_PROCESSED_DIR=data/processed

# Logging
LOG_LEVEL=INFO
